{
  "name": "System monitor",
  "version": "1.0.0",
  "author": "WinDock",
  "description": "One performance metric (CPU, memory, GPU, disk, network or a HWiNFO sensor) as a graph, bar, ring, gauge, dial or number.",
  "api": 1,
  "size": {
    "horizontal": { "main": 96, "cross": 48 },
    "vertical": { "main": 48, "cross": 48 }
  },
  "standalone": { "minWidth": 60, "minHeight": 40, "defaultWidth": 160, "defaultHeight": 120 },
  "permissions": ["perf"],
  "settings": [
    { "key": "metric", "group": "Metric", "type": "choice", "choiceFrom": "perf", "label": "Metric", "default": "cpu.total",
      "description": "What it shows. HWiNFO's sensors are listed while HWiNFO runs with Shared Memory Support on; a metric that is not available now keeps its place and shows a dash." },
    { "key": "label", "group": "Metric", "type": "string", "label": "Label", "default": "",
      "description": "Empty: the metric's own name." },
    { "key": "unit", "group": "Metric", "type": "string", "label": "Unit", "default": "",
      "description": "Empty: the metric's unit. Text here replaces it and shows the value unscaled." },
    { "key": "decimals", "group": "Metric", "type": "int", "label": "Decimals", "min": 0, "max": 3, "default": 0,
      "description": "Scaled values under 10 (3.4 GB) get at least one." },
    { "key": "scale", "group": "Metric", "type": "choice", "label": "Scale", "default": "auto",
      "choices": [ { "value": "auto", "label": "Automatic (KB, MB, GB; KB/s ... GB/s; days and hours)" },
                   { "value": "raw", "label": "Raw (bytes, bytes/s, seconds)" } ] },
    { "key": "refresh", "group": "Metric", "type": "int", "label": "Update every", "min": 250, "max": 10000, "step": 250, "default": 1000, "unit": "ms",
      "description": "The sampler runs at the fastest rate any widget asks for." },
    { "key": "style", "group": "Display", "type": "choice", "label": "Style", "default": "graph",
      "choices": [ { "value": "graph", "label": "Graph (a line over time)" },
                   { "value": "area", "label": "Area (a filled graph)" },
                   { "value": "sparkline", "label": "Sparkline and value" },
                   { "value": "bar", "label": "Bar (horizontal)" },
                   { "value": "vbar", "label": "Bar (vertical)" },
                   { "value": "ring", "label": "Ring" },
                   { "value": "gauge", "label": "Gauge (a half circle with a needle)" },
                   { "value": "dial", "label": "Dial (a speedometer)" },
                   { "value": "percent", "label": "Percent (a big number)" },
                   { "value": "value", "label": "Value (a big number and its unit)" },
                   { "value": "text", "label": "Text (label: value)" } ] },
    { "key": "historySeconds", "group": "Display", "type": "int", "label": "History shown", "min": 10, "max": 600, "step": 10, "default": 60, "unit": "seconds",
      "description": "Graphs and sparklines (at most 600 samples)." },
    { "key": "showLabel", "group": "Display", "type": "bool", "label": "Show the label", "default": true },
    { "key": "showValue", "group": "Display", "type": "bool", "label": "Show the value", "default": true },
    { "key": "showMinMax", "group": "Display", "type": "bool", "label": "Show the lowest and highest value (graphs) or the range (gauges, bars)", "default": false },
    { "key": "lineWidth", "group": "Display", "type": "int", "label": "Line width", "min": 1, "max": 6, "default": 2, "unit": "DIPs" },
    { "key": "fill", "group": "Display", "type": "bool", "label": "Fill under the line (graph, sparkline)", "default": false },
    { "key": "sweep", "group": "Display", "type": "int", "label": "Arc", "min": 0, "max": 300, "step": 10, "default": 0, "unit": "degrees",
      "description": "Gauge, dial and ring: 0 is the style's own (gauge 180, dial 240, ring 270); otherwise 90 - 300." },
    { "key": "rangeMin", "group": "Display", "type": "number", "label": "Range from", "default": 0,
      "description": "In the metric's own unit (bytes for memory). Both 0: the metric's range (rates: up to the highest value shown)." },
    { "key": "rangeMax", "group": "Display", "type": "number", "label": "Range to", "default": 0 },
    { "key": "smooth", "group": "Display", "type": "bool", "label": "Smooth (the average of the last 3 samples)", "default": false },
    { "key": "color", "group": "Colours", "type": "colour", "label": "Colour", "default": "#00000000",
      "description": "#00000000 (transparent): the theme's accent colour." },
    { "key": "warnAt", "group": "Colours", "type": "number", "label": "Warning from", "default": 0,
      "description": "In the metric's own unit; 0: off." },
    { "key": "warnColor", "group": "Colours", "type": "colour", "label": "Warning colour", "default": "#FFFFB900" },
    { "key": "criticalAt", "group": "Colours", "type": "number", "label": "Critical from", "default": 0,
      "description": "In the metric's own unit; 0: off." },
    { "key": "criticalColor", "group": "Colours", "type": "colour", "label": "Critical colour", "default": "#FFE81123" },
    { "key": "background", "group": "Colours", "type": "choice", "label": "Background", "default": "none",
      "choices": [ { "value": "none", "label": "None" },
                   { "value": "panel", "label": "A dark panel" },
                   { "value": "theme", "label": "The theme's label panel" } ] },
    { "key": "textColor", "group": "Colours", "type": "colour", "label": "Text colour", "default": "#00000000",
      "description": "#00000000: the theme's text colour." },
    { "key": "width", "group": "Size", "type": "int", "label": "Width on a top or bottom dock", "min": 40, "max": 400, "default": 96, "unit": "DIPs",
      "description": "The height is the dock's icon size; a left or right dock shows a square. On the desktop the widget fills its window." }
  ]
}
