{
  "name": "System overview",
  "version": "1.0.0",
  "author": "WinDock",
  "description": "CPU, memory, GPU, disk and network at a glance: one row on a dock, a list with sparklines on the desktop.",
  "api": 1,
  "size": {
    "horizontal": { "main": 200, "cross": 48 },
    "vertical": { "main": 120, "cross": 48 }
  },
  "standalone": { "minWidth": 120, "minHeight": 60, "defaultWidth": 240, "defaultHeight": 160 },
  "permissions": ["perf"],
  "settings": [
    { "key": "showCpu", "group": "Rows", "type": "bool", "label": "CPU", "default": true },
    { "key": "showMemory", "group": "Rows", "type": "bool", "label": "Memory", "default": true },
    { "key": "showGpu", "group": "Rows", "type": "bool", "label": "GPU", "default": true },
    { "key": "showDisk", "group": "Rows", "type": "bool", "label": "Disk", "default": true },
    { "key": "showNetwork", "group": "Rows", "type": "bool", "label": "Network", "default": true },
    { "key": "rows", "group": "Display", "type": "choice", "label": "Layout", "default": "auto",
      "choices": [ { "value": "auto", "label": "Automatic (a dock: one row; the desktop: a list)" },
                   { "value": "row", "label": "One row" },
                   { "value": "list", "label": "A list" } ] },
    { "key": "style", "group": "Display", "type": "choice", "label": "Style", "default": "auto",
      "choices": [ { "value": "auto", "label": "Automatic (one row: bars; a list: sparklines)" },
                   { "value": "bars", "label": "Bars" },
                   { "value": "sparklines", "label": "Sparklines" } ] },
    { "key": "showValues", "group": "Display", "type": "bool", "label": "Show the values", "default": true },
    { "key": "historySeconds", "group": "Display", "type": "int", "label": "Sparkline history", "min": 10, "max": 600, "step": 10, "default": 60, "unit": "seconds" },
    { "key": "refresh", "group": "Display", "type": "int", "label": "Update every", "min": 250, "max": 10000, "step": 250, "default": 1000, "unit": "ms" },
    { "key": "color", "group": "Colours", "type": "colour", "label": "Colour", "default": "#00000000",
      "description": "#00000000 (transparent): the theme's accent colour." },
    { "key": "warnAt", "group": "Colours", "type": "number", "label": "Warning from", "default": 75, "unit": "%",
      "description": "CPU, memory, GPU and disk (percent); 0: off." },
    { "key": "warnColor", "group": "Colours", "type": "colour", "label": "Warning colour", "default": "#FFFFB900" },
    { "key": "criticalAt", "group": "Colours", "type": "number", "label": "Critical from", "default": 90, "unit": "%" },
    { "key": "criticalColor", "group": "Colours", "type": "colour", "label": "Critical colour", "default": "#FFE81123" },
    { "key": "background", "group": "Colours", "type": "choice", "label": "Background", "default": "none",
      "choices": [ { "value": "none", "label": "None" },
                   { "value": "panel", "label": "A dark panel" },
                   { "value": "theme", "label": "The theme's label panel" } ] },
    { "key": "textColor", "group": "Colours", "type": "colour", "label": "Text colour", "default": "#00000000",
      "description": "#00000000: the theme's text colour." },
    { "key": "cellWidth", "group": "Size", "type": "int", "label": "Width of a row's cell on a top or bottom dock", "min": 28, "max": 120, "default": 44, "unit": "DIPs" }
  ]
}
