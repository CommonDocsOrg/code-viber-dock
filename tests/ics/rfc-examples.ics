BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//WinDock//tests//EN
X-WR-CALNAME:RFC 5545 examples
COMMENT:TZID America/New_York has no VTIMEZONE here: the Windows zone fallback (table) is used.
BEGIN:VEVENT
UID:wkst-mo@test
SUMMARY:Every other week TU SU WKST MO
DTSTART;TZID=America/New_York:19970805T090000
DURATION:PT1H
RRULE:FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=MO
END:VEVENT
BEGIN:VEVENT
UID:wkst-su@test
SUMMARY:Every other week TU SU WKST SU
DTSTART;TZID=America/New_York:19970805T090000
DURATION:PT1H
RRULE:FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=SU
END:VEVENT
BEGIN:VEVENT
UID:first-friday@test
SUMMARY:First Friday
DTSTART;TZID=America/New_York:19970905T090000
DTEND;TZID=America/New_York:19970905T100000
RRULE:FREQ=MONTHLY;COUNT=10;BYDAY=1FR
END:VEVENT
BEGIN:VEVENT
UID:first-last-sunday@test
SUMMARY:First and last Sunday
DTSTART;TZID=America/New_York:19970907T090000
DTEND;TZID=America/New_York:19970907T100000
RRULE:FREQ=MONTHLY;INTERVAL=2;COUNT=10;BYDAY=1SU,-1SU
END:VEVENT
BEGIN:VEVENT
UID:last-workday@test
SUMMARY:Last work day
DTSTART;TZID=America/New_York:19970930T090000
DTEND;TZID=America/New_York:19970930T100000
RRULE:FREQ=MONTHLY;COUNT=3;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1
END:VEVENT
BEGIN:VEVENT
UID:election@test
SUMMARY:Election day
DTSTART;TZID=America/New_York:19961105T090000
DTEND;TZID=America/New_York:19961105T100000
RRULE:FREQ=YEARLY;INTERVAL=4;COUNT=3;BYMONTH=11;BYDAY=TU;BYMONTHDAY=2,3,4,5,6,7,8
END:VEVENT
BEGIN:VEVENT
UID:june-july@test
SUMMARY:June and July
DTSTART;TZID=America/New_York:19970610T090000
DTEND;TZID=America/New_York:19970610T100000
RRULE:FREQ=YEARLY;COUNT=4;BYMONTH=6,7
END:VEVENT
BEGIN:VEVENT
UID:friday-13@test
SUMMARY:Friday the 13th
DTSTART;TZID=America/New_York:19970902T090000
DTEND;TZID=America/New_York:19970902T100000
EXDATE;TZID=America/New_York:19970902T090000
RRULE:FREQ=MONTHLY;BYDAY=FR;BYMONTHDAY=13
END:VEVENT
END:VCALENDAR
