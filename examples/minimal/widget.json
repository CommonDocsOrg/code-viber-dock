{
  "name": "Minimal (example)",
  "version": "1.0.0",
  "author": "WinDock examples",
  "description": "The smallest useful widget: one line of text in the dock's colours, sized by measure().",
  "main": "main.js",
  "size": {
    "horizontal": { "main": 64, "cross": 40 },
    "vertical": { "main": 40, "cross": 48 }
  },
  "settings": [
    { "key": "text", "type": "string", "label": "Text", "default": "Hello" },
    { "key": "accent", "type": "bool", "label": "Use the accent colour", "default": false }
  ]
}
