#include <winres.h>
#include "../src/resource.h"

IDI_APP ICON "dock.ico"

// Built-in widgets: their sources live in the repo's widgets folder (shipped as source, never
// bytecode). WidgetPackage.cpp maps them to package paths.
IDR_WIDGET_HELLO_JSON RCDATA "../widgets/hello/widget.json"
IDR_WIDGET_HELLO_MAIN RCDATA "../widgets/hello/main.js"
IDR_WIDGET_CLOCK_JSON RCDATA "../widgets/digital-clock/widget.json"
IDR_WIDGET_CLOCK_MAIN RCDATA "../widgets/digital-clock/main.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "WinDock"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "WinDock"
      VALUE "OriginalFilename", "WinDock.exe"
      VALUE "ProductName", "WinDock"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
