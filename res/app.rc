VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,5,3,0
 PRODUCTVERSION 0,5,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CodeViber.org"
      VALUE "FileDescription", "ViberDock by CodeViber.org"
      VALUE "FileVersion", "0.5.3"
      VALUE "InternalName", "WinDock"
      VALUE "OriginalFilename", "WinDock.exe"
      VALUE "ProductName", "ViberDock"
      VALUE "ProductVersion", "0.5.3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
