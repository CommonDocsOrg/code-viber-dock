#include <winres.h>
#include "../src/resource.h"

IDI_APP ICON "dock.ico"

// Built-in widgets: their sources live in the repo's widgets folder (shipped as source, never
// bytecode). WidgetPackage.cpp maps them to package paths.
IDR_WIDGET_HELLO_JSON RCDATA "../widgets/hello/widget.json"
IDR_WIDGET_HELLO_MAIN RCDATA "../widgets/hello/main.js"
IDR_WIDGET_CLOCK_JSON RCDATA "../widgets/digital-clock/widget.json"
IDR_WIDGET_CLOCK_MAIN RCDATA "../widgets/digital-clock/main.js"
IDR_WIDGET_ANALOG_JSON RCDATA "../widgets/analog-clock/widget.json"
IDR_WIDGET_ANALOG_MAIN RCDATA "../widgets/analog-clock/main.js"
IDR_WIDGET_ANALOG_FACE_CLASSIC RCDATA "../widgets/analog-clock/faces/classic.json"
IDR_WIDGET_ANALOG_FACE_MINIMAL RCDATA "../widgets/analog-clock/faces/minimal.json"
IDR_WIDGET_ANALOG_FACE_MODERN_DARK RCDATA "../widgets/analog-clock/faces/modern-dark.json"
IDR_WIDGET_ANALOG_FACE_ROMAN RCDATA "../widgets/analog-clock/faces/roman.json"
IDR_WIDGET_ANALOG_FACE_STATION RCDATA "../widgets/analog-clock/faces/station.json"
IDR_WIDGET_DATE_JSON RCDATA "../widgets/analog-date/widget.json"
IDR_WIDGET_DATE_MAIN RCDATA "../widgets/analog-date/main.js"
IDR_WIDGET_VOLUME_JSON RCDATA "../widgets/volume/widget.json"
IDR_WIDGET_VOLUME_MAIN RCDATA "../widgets/volume/main.js"
IDR_WIDGET_MEDIA_JSON RCDATA "../widgets/media/widget.json"
IDR_WIDGET_MEDIA_MAIN RCDATA "../widgets/media/main.js"
IDR_WIDGET_START_JSON RCDATA "../widgets/start/widget.json"
IDR_WIDGET_START_MAIN RCDATA "../widgets/start/main.js"
IDR_WIDGET_SEARCH_JSON RCDATA "../widgets/search/widget.json"
IDR_WIDGET_SEARCH_MAIN RCDATA "../widgets/search/main.js"
IDR_WIDGET_BELL_JSON RCDATA "../widgets/notification-bell/widget.json"
IDR_WIDGET_BELL_MAIN RCDATA "../widgets/notification-bell/main.js"
IDR_WIDGET_AGENDA_JSON RCDATA "../widgets/agenda/widget.json"
IDR_WIDGET_AGENDA_MAIN RCDATA "../widgets/agenda/main.js"
IDR_WIDGET_WEATHER_JSON RCDATA "../widgets/weather/widget.json"
IDR_WIDGET_WEATHER_MAIN RCDATA "../widgets/weather/main.js"
IDR_CLOCKFACE_DEFAULT RCDATA "clock-faces/default.json"
IDR_CLOCKFACE_LARGE RCDATA "clock-faces/large-time-small-date.json"
IDR_CLOCKFACE_MONO_PILL RCDATA "clock-faces/mono-pill.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "WinDock"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "WinDock"
      VALUE "OriginalFilename", "WinDock.exe"
      VALUE "ProductName", "WinDock"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
